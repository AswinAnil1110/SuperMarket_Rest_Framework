#API for ProductListCreateView
###
GET http://127.0.0.1:8000/store/products/
Accept: application/json

###
POST http://127.0.0.1:8000/store/products/
Content-Type: application/json

{
    "product_name" : "Lays",
    "category" : "Chips",
    "price" : 30,
    "production_date" : "2027-01-20",
    "expiry_date" : "2028-01-20",
    "stock" : 30
}

# API for ProductRetriveUpdateDeleteView
###
GET http://127.0.0.1:8000/store/products/3/
Accept: application/json

###
PUT http://127.0.0.1:8000/store/products/3/
Content-Type: application/json

{
    "product_name" : "Lays",
    "category" : "Chips",
    "price" : 25,
    "production_date" : "2027-5-23",
    "expiry_date" : "2028-01-20",
