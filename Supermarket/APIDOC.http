}

###
DELETE http://127.0.0.1:8000/store/products/2/

#API for OrderListCreateView
###
GET http://127.0.0.1:8000/store/orders/
Accept: application/json

###
POST http://127.0.0.1:8000/store/orders/
Content-Type: application/json

{
    "customer_name" : "Hari",
    "product_id" : 1,
    "quantity" : 2,
    "payment_type" : "upi"
}

#API for OrderRetriveUpdateDeleteView
###
GET http://127.0.0.1:8000/store/orders/2/
Accept: application/json

###
PUT http://127.0.0.1:8000/store/orders/3/
Content-Type: application/json

{
    "customer_name" : "Manu",
    "product_id" : 1,
    "quantity" : 6,
